# AgentOS egress proxy. Runner and browser containers have no direct internet; everything goes through here.
# The filter file is generated by entrypoint.sh from EGRESS_ALLOWLIST plus /config/allowlist.extra
# (the gateway writes that file when you approve a new domain).
User tinyproxy
Group tinyproxy
Port 3128
Listen 0.0.0.0
Timeout 120
MaxClients 100
LogLevel Info
# Private ranges = the docker networks. Anything else is refused.
Allow 127.0.0.1
Allow 10.0.0.0/8
Allow 172.16.0.0/12
Allow 192.168.0.0/16
ConnectPort 443
ConnectPort 80
DisableViaHeader Yes
Filter "/etc/tinyproxy/filter"
FilterType ere
FilterURLs Off
FilterDefaultDeny Yes
